# Шаблон .env. Скопируйте в .env и заполните пустые значения.
# Файл .env в git не попадает. bot и worker читают .env.app — копию .env
# без DATABASE_URL, POSTGRES_PASSWORD и BACKUP_PASSPHRASE (собирается командой из docs/SETUP.md).

# ── Telegram ─────────────────────────────────────────────────────────
# Токен бота от BotFather. Privacy mode у бота должен быть выключен.
BOT_TOKEN=
# Telegram ID человека, который станет владельцем при первом /start.
BOOTSTRAP_OWNER_TG_ID=
# ID бота-интегратора Bitrix24 (from.id его сообщений в группах); смена значения
# пересчитывает стороны всей истории.
INTEGRATOR_BOT_ID=
# ID служебной группы уведомлений — единственной группы, куда боту можно писать.
NOTIFY_GROUP_CHAT_ID=
# Типы апдейтов для long polling; без callback_query кнопки не работают.
ALLOWED_UPDATES=message,edited_message,callback_query,my_chat_member,chat_member

# ── PostgreSQL ───────────────────────────────────────────────────────
# База доступна только внутри Docker-сети по postgres:5432.
# Хостовый порт 5432 не нужен; в DSN оставлять postgres, не localhost.
# Владелец схемы (миграции, бэкапы). Используется сервисом postgres в compose.
POSTGRES_USER=botuser
# Пароль владельца схемы.
POSTGRES_PASSWORD=
# Имя базы.
POSTGRES_DB=chatstats
# DSN владельца схемы: postgresql+asyncpg://botuser:<POSTGRES_PASSWORD>@postgres:5432/chatstats
DATABASE_URL=
# DSN роли приложения botapp (только DML): postgresql+asyncpg://botapp:<пароль botapp>@postgres:5432/chatstats
APP_DATABASE_URL=

# ── ИИ-провайдер (OpenAI-совместимый API) ────────────────────────────
# Включить классификацию сообщений моделью.
AI_ENABLED=true
# true — вердикты модели пишутся, но на обращения и алерты не влияют.
AI_SHADOW_MODE=false
# Адрес API провайдера.
AI_BASE_URL=https://foundation-models.api.cloud.ru/v1
# Основная модель.
AI_MODEL=openai/gpt-oss-120b
# Ключ API: при установке вписать вручную до сборки .env.app; scripts/set_ai_key.sh — только для замены ключа на работающей установке (пересоздаёт bot и worker).
AI_API_KEY=
# Потолок токенов в месяц; при достижении классификация останавливается.
AI_MONTHLY_TOKEN_LIMIT=40000000
# Профиль промпта (app/services/ai.py, PROMPT_PROFILES); пусто — по имени модели.
AI_PROMPT_PROFILE=gptoss-p14
# Модели, которыми размечена история в базе. Не сокращать: сообщения удалённой модели
# уйдут на повторную (платную) разметку, а прошлые отчёты пересчитаются.
AI_PREVIOUS_MODELS=
# Резервная модель: на неё уходят вызовы при серии отказов основной; пусто — резерва нет.
AI_FALLBACK_MODEL=deepseek-ai/DeepSeek-V4-Pro
# Профиль промпта резервной модели.
AI_FALLBACK_PROMPT_PROFILE=deepseek-ds1b
# Цена входных токенов, руб. за миллион (для расхода на экране «Состояние системы»).
AI_PRICE_IN_PER_M=96.22
# Цена выходных токенов, руб. за миллион.
AI_PRICE_OUT_PER_M=288.6

# Необязательные настройки ИИ; ниже значения по умолчанию.
# Таймаут одного вызова классификации, секунд.
# AI_TIMEOUT_SECONDS=60
# Медиана задержки выше порога — состояние «провайдер медленный», секунд.
# AI_SLOW_LATENCY_SECONDS=10
# Самое старое сообщение ждёт вердикта дольше порога — «разметка отстаёт», минут.
# AI_SLOW_QUEUE_MINUTES=15
# Сколько отказов основной модели подряд переводят на резерв.
# AI_FALLBACK_RETRIES=3
# Окно, в котором отказы считаются подряд, секунд.
# AI_FALLBACK_RETRY_WINDOW_SECONDS=300
# Как часто в режиме резерва пробовать основную модель, секунд.
# AI_FALLBACK_PROBE_SECONDS=1800
# Сколько удачных проб подряд возвращают основную модель.
# AI_FALLBACK_RESTORE_SUCCESSES=2

# ── Приложение ───────────────────────────────────────────────────────
# Часовой пояс контейнеров и логов (рабочий календарь задаётся в боте).
TZ=Europe/Moscow
# Уровень логов: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Метка окружения, видна на экране «Состояние системы».
ENVIRONMENT=dev

# ── Движок обращений: границы версий правил ──────────────────────────
# Обращения, открытые с этого момента, считаются по правилам v2. Не сдвигать.
# Для новой установки не нужна: v4 включает v2 и v3.
EPISODE_RULES_V2_SINCE=
# Граница правил v3; пусто — отдельно не включается (v4 включает v3).
EPISODE_RULES_V3_SINCE=
# Обращения, открытые с этого момента, считаются по правилам v4. Не сдвигать.
# Новая установка: момент раньше первого сообщения (например, дата установки).
EPISODE_RULES_V4_SINCE=2026-01-01T00:00:00+00:00

# ── Бэкапы ───────────────────────────────────────────────────────────
# Пароль шифрования дампов; читают scripts/backup.sh и restore_test.sh (они подгружают .env).
# BACKUP_PASSPHRASE=
